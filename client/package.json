{
  "name": "scrap-street-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:realtime": "node --experimental-strip-types tests/realtime.integration.mjs",
    "test:weapons": "node --experimental-strip-types tests/weapons.integration.mjs",
    "test:loot": "node --experimental-strip-types tests/loot.integration.mjs",
    "test:browser": "node --experimental-strip-types tests/browser.integration.mjs",
    "test:layout": "node tests/layout.integration.mjs",
    "test:movement": "node --experimental-strip-types tests/movement.integration.mjs",
    "test:movement:conformance": "node --experimental-strip-types tests/movement.conformance.mjs",
    "test:events": "node --experimental-strip-types tests/events.integration.mjs",
    "test:movement:server": "node --experimental-strip-types tests/movement.server.integration.mjs",
    "test:rooms": "node --experimental-strip-types tests/rooms.integration.mjs",
    "test:match": "node --experimental-strip-types tests/match.integration.mjs",
    "test:match:store": "dotnet run --no-restore --project ../tests/Game.PersistenceProbe/Game.PersistenceProbe.csproj",
    "test:rooms:rules": "dotnet run --project ../tests/Game.RoomProbe/Game.RoomProbe.csproj",
    "format": "prettier --write src vite.config.ts index.html",
    "format:check": "prettier --check src vite.config.ts index.html"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@microsoft/signalr-protocol-msgpack": "^10.0.11",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
